<Window
    x:Class="ImageConversion.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="SE Image Converter">

    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <MenuBar Grid.Row="0" Grid.ColumnSpan="3" Margin="24,0,24,8">
            <MenuBarItem Title="File">
                <MenuFlyoutItem Text="Export" Click="ExportButton_Click">
                    <MenuFlyoutItem.Icon>
                        <SymbolIcon Symbol="Save" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Exit" Click="ExitMenuItem_Click">
                    <MenuFlyoutItem.Icon>
                        <SymbolIcon Symbol="ClosePane" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuBarItem>

            <MenuBarItem Title="Help">
                <MenuFlyoutItem Text="About" Click="AboutMenuItem_Click">
                    <MenuFlyoutItem.Icon>
                        <SymbolIcon Symbol="Help" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Guide" Click="GuideMenuItem_Click">
                    <MenuFlyoutItem.Icon>
                        <SymbolIcon Symbol="Library" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Check for Updates" Click="CheckForUpdatesMenuItem_Click">
                    <MenuFlyoutItem.Icon>
                        <SymbolIcon Symbol="Refresh" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuBarItem>
        </MenuBar>

        <Border
            Grid.Row="1"
            Grid.Column="0"
            Margin="24,0,0,24"
            Padding="22,20"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            CornerRadius="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="18">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Width="28" Height="28" CornerRadius="14" Background="{ThemeResource AccentFillColorDefaultBrush}">
                                <TextBlock Text="1" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Source Image" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>

                        <Border
                            AllowDrop="True"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            DragOver="SourceDropZone_DragOver"
                            Drop="SourceDropZone_Drop"
                            Height="172"
                            Tapped="SourceDropZone_Tapped">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                <FontIcon Glyph="&#xEB9F;" FontSize="44" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="Drag &amp; drop an image here" HorizontalAlignment="Center" />
                                <TextBlock Text="or click to browse" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding SourceSummary}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Width="28" Height="28" CornerRadius="14" Background="{ThemeResource AccentFillColorDefaultBrush}">
                                <TextBlock Text="2" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Conversion Settings" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>

                        <ComboBox
                            Header="LCD/Text Panel type"
                            ItemsSource="{Binding PanelPresets}"
                            SelectedItem="{Binding SelectedPanelPreset, Mode=TwoWay}"
                            HorizontalAlignment="Stretch" />

                        <ComboBox
                            Header="Resize mode"
                            ItemsSource="{Binding ResizeModes}"
                            SelectedItem="{Binding SelectedResizeMode, Mode=TwoWay}"
                            HorizontalAlignment="Stretch" />

                        <ComboBox
                            Header="Dithering mode"
                            ItemsSource="{Binding DitheringModes}"
                            SelectedItem="{Binding SelectedDitheringMode, Mode=TwoWay}"
                            HorizontalAlignment="Stretch" />

                        <ToggleSwitch Header="Maintain aspect ratio" IsOn="{Binding MaintainAspectRatio, Mode=TwoWay}" />
                        <ToggleSwitch Header="Preserve transparency" IsOn="{Binding PreserveTransparency, Mode=TwoWay}" />

                        <InfoBar
                            IsOpen="{Binding IsOutputStale}"
                            Severity="Warning"
                            Title="Settings changed"
                            Message="Convert again to refresh the output." />

                        <Button
                            Command="{Binding ConvertCommand}"
                            HorizontalAlignment="Stretch"
                            Padding="14"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            Foreground="White">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                <FontIcon Glyph="&#xE8B9;" FontSize="16" />
                                <TextBlock Text="Convert Image" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <Button
                            Click="ExportButton_Click"
                            HorizontalAlignment="Stretch"
                            Padding="14">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                <SymbolIcon Symbol="Save" />
                                <TextBlock Text="Export" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>

                        <InfoBar
                            IsOpen="{Binding HasStatusMessage}"
                            Severity="{Binding StatusSeverity}"
                            Title="{Binding StatusTitle}"
                            Message="{Binding StatusMessage}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="1" Grid.Column="2" RowSpacing="20" Margin="0,0,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="360" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Padding="20"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8">
                <Grid RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Preview" FontSize="20" FontWeight="SemiBold" />

                    <Grid Grid.Row="1" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Original Image" FontWeight="SemiBold" />
                            <Border Grid.Row="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                <Grid>
                                    <Image Source="{Binding SourcePreview}" Stretch="Uniform" />
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="{Binding SourcePlaceholderVisibility}">
                                        <FontIcon Glyph="&#xEB9F;" FontSize="34" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="No image loaded" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid Grid.Column="1" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Converted Preview" FontWeight="SemiBold" />
                            <Border Grid.Row="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                <Grid>
                                    <Image Source="{Binding ConvertedPreview}" Stretch="Uniform" />
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="{Binding ConvertedPlaceholderVisibility}">
                                        <TextBlock Text="Preview will appear here" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Conversion output" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <Border
                Grid.Row="1"
                Padding="20"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8">
                <Grid RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE943;" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Converted String" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                            <Button Command="{Binding CopyCommand}" Padding="14,8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Copy" />
                                    <TextBlock Text="Copy" />
                                </StackPanel>
                            </Button>
                            <Button Click="ExportButton_Click" Padding="14,8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Save" />
                                    <TextBlock Text="Export" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <TextBox
                        Grid.Row="1"
                        Text="{Binding ConvertedText, Mode=TwoWay}"
                        AcceptsReturn="True"
                        TextWrapping="NoWrap"
                        FontFamily="Consolas"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Auto" />

                    <Grid Grid.Row="2">
                        <TextBlock Text="{Binding CharacterCountSummary}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding LineCountSummary}" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
