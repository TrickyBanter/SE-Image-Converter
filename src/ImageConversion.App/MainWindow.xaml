<Window
    x:Class="ImageConversion.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="SE Image Converter">

    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0" DefaultLabelPosition="Right">
            <AppBarButton Icon="OpenFile" Label="Open" Click="PickImageButton_Click" />
            <AppBarButton Icon="Accept" Label="Convert" Command="{Binding ConvertCommand}" />
            <AppBarButton Icon="Copy" Label="Copy" Command="{Binding CopyCommand}" />
            <AppBarButton Icon="Save" Label="Export" Click="ExportButton_Click" />
        </CommandBar>

        <Grid Grid.Row="1" Padding="24" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="18">
                    <TextBlock Text="Image" Style="{ThemeResource TitleTextBlockStyle}" />
                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" MinHeight="210">
                        <Image Source="{Binding SourcePreview}" Stretch="Uniform" />
                    </Border>

                    <TextBlock Text="{Binding SourceSummary}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <TextBlock Text="Panel" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <ComboBox
                        Header="LCD/Text Panel type"
                        ItemsSource="{Binding PanelPresets}"
                        SelectedItem="{Binding SelectedPanelPreset, Mode=TwoWay}"
                        HorizontalAlignment="Stretch" />

                    <ComboBox
                        Header="Resize mode"
                        ItemsSource="{Binding ResizeModes}"
                        SelectedItem="{Binding SelectedResizeMode, Mode=TwoWay}"
                        HorizontalAlignment="Stretch" />

                    <ComboBox
                        Header="Dithering mode"
                        ItemsSource="{Binding DitheringModes}"
                        SelectedItem="{Binding SelectedDitheringMode, Mode=TwoWay}"
                        HorizontalAlignment="Stretch" />

                    <ToggleSwitch Header="Maintain aspect ratio" IsOn="{Binding MaintainAspectRatio, Mode=TwoWay}" />
                    <ToggleSwitch Header="Preserve transparency" IsOn="{Binding PreserveTransparency, Mode=TwoWay}" />

                    <InfoBar
                        IsOpen="{Binding HasStatusMessage}"
                        Severity="{Binding StatusSeverity}"
                        Title="{Binding StatusTitle}"
                        Message="{Binding StatusMessage}" />
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="1" RowSpacing="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="2*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="10">
                        <TextBlock Text="Converted Preview" Style="{ThemeResource TitleTextBlockStyle}" />
                        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" MinHeight="220">
                            <Image Source="{Binding ConvertedPreview}" Stretch="Uniform" />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" MinWidth="190" Spacing="8" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding ResultSizeSummary}" />
                        <TextBlock Text="{Binding CharacterCountSummary}" />
                        <TextBlock Text="Space Engineers: Text and Images, Font: Monospace, Font Size: 0.1" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Converted String" Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBox
                        Grid.Row="1"
                        Text="{Binding ConvertedText, Mode=TwoWay}"
                        AcceptsReturn="True"
                        TextWrapping="NoWrap"
                        FontFamily="Consolas"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
