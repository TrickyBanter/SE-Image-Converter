<Window
    x:Class="ImageConversion.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="SE Image Converter">

    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <MenuBar Grid.Row="0" Margin="24,0,24,8">
            <MenuBarItem Title="File">
                <MenuFlyoutItem Text="Export" Click="ExportButton_Click">
                    <MenuFlyoutItem.Icon>
                        <SymbolIcon Symbol="Save" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Exit" Click="ExitMenuItem_Click">
                    <MenuFlyoutItem.Icon>
                        <SymbolIcon Symbol="ClosePane" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuBarItem>

            <MenuBarItem Title="Help">
                <MenuFlyoutItem Text="About" Click="AboutMenuItem_Click">
                    <MenuFlyoutItem.Icon>
                        <SymbolIcon Symbol="Help" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Guide" Click="GuideMenuItem_Click">
                    <MenuFlyoutItem.Icon>
                        <SymbolIcon Symbol="Library" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Check for Updates" Click="CheckForUpdatesMenuItem_Click">
                    <MenuFlyoutItem.Icon>
                        <SymbolIcon Symbol="Refresh" />
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuBarItem>
        </MenuBar>

        <NavigationView
            x:Name="FeatureNavigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="False"
            IsSettingsVisible="False"
            CompactPaneLength="56"
            OpenPaneLength="220"
            PaneDisplayMode="LeftCompact"
            PaneTitle="Tools"
            SelectionChanged="FeatureNavigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="ImageConverterNavigationItem" Content="Image Converter" Tag="ImageConverter">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Pictures" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Jump Drive Calculator" Tag="JumpDriveCalculator">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE800;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Resource Calculator" Tag="ResourceCalculator">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Calculator" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Settings" Tag="Settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Grid Margin="24,16,24,24">
                <Grid Visibility="{Binding ImageConverterVisibility}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Grid.Column="0"
                        Padding="22,20"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        CornerRadius="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="18">
                                <StackPanel Spacing="14">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Border Width="28" Height="28" CornerRadius="14" Background="{ThemeResource AccentFillColorDefaultBrush}">
                                            <TextBlock Text="1" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Source Image" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <Border
                                        AllowDrop="True"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        DragOver="SourceDropZone_DragOver"
                                        Drop="SourceDropZone_Drop"
                                        Height="172"
                                        Tapped="SourceDropZone_Tapped">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                            <FontIcon Glyph="&#xEB9F;" FontSize="44" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="Drag &amp; drop an image here" HorizontalAlignment="Center" />
                                            <TextBlock Text="or click to browse" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="{Binding SourceSummary}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>

                                <StackPanel Spacing="14">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Border Width="28" Height="28" CornerRadius="14" Background="{ThemeResource AccentFillColorDefaultBrush}">
                                            <TextBlock Text="2" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock Text="Conversion Settings" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <ComboBox
                                        Header="LCD/Text Panel type"
                                        ItemsSource="{Binding PanelPresets}"
                                        SelectedItem="{Binding SelectedPanelPreset, Mode=TwoWay}"
                                        HorizontalAlignment="Stretch" />

                                    <ComboBox
                                        Header="Resize mode"
                                        ItemsSource="{Binding ResizeModes}"
                                        SelectedItem="{Binding SelectedResizeMode, Mode=TwoWay}"
                                        HorizontalAlignment="Stretch" />

                                    <ComboBox
                                        Header="Dithering mode"
                                        ItemsSource="{Binding DitheringModes}"
                                        SelectedItem="{Binding SelectedDitheringMode, Mode=TwoWay}"
                                        HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ToolTipService.ToolTip="{Binding Description}">
                                                    <TextBlock Text="{Binding Name}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>

                                    <ToggleSwitch Header="Maintain aspect ratio" IsOn="{Binding MaintainAspectRatio, Mode=TwoWay}" />
                                    <ToggleSwitch Header="Preserve transparency" IsOn="{Binding PreserveTransparency, Mode=TwoWay}" />

                                    <InfoBar
                                        IsOpen="{Binding IsOutputStale}"
                                        Severity="Warning"
                                        Title="Settings changed"
                                        Message="Convert again to refresh the output." />

                                    <Button
                                        Command="{Binding ConvertCommand}"
                                        HorizontalAlignment="Stretch"
                                        Padding="14"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        Foreground="White">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                            <FontIcon Glyph="&#xE8B9;" FontSize="16" />
                                            <TextBlock Text="Convert Image" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>

                                    <InfoBar
                                        IsOpen="{Binding HasStatusMessage}"
                                        Severity="{Binding StatusSeverity}"
                                        Title="{Binding StatusTitle}"
                                        Message="{Binding StatusMessage}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

        <Grid Grid.Row="1" Grid.Column="2" RowSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="360" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Padding="20"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8">
                <Grid RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Preview" FontSize="20" FontWeight="SemiBold" />

                    <Grid Grid.Row="1" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Original Image" FontWeight="SemiBold" />
                            <Border Grid.Row="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                <Grid>
                                    <Image Source="{Binding SourcePreview}" Stretch="Uniform" />
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="{Binding SourcePlaceholderVisibility}">
                                        <FontIcon Glyph="&#xEB9F;" FontSize="34" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="No image loaded" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid Grid.Column="1" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Converted Preview" FontWeight="SemiBold" />
                            <Border Grid.Row="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                <Grid>
                                    <Image Source="{Binding ConvertedPreview}" Stretch="Uniform" />
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="{Binding ConvertedPlaceholderVisibility}">
                                        <TextBlock Text="Preview will appear here" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Text="Conversion output" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <Border
                Grid.Row="1"
                Padding="20"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8">
                <Grid RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE943;" FontSize="24" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Converted String" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                            <Button Command="{Binding CopyCommand}" Padding="14,8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Copy" />
                                    <TextBlock Text="Copy" />
                                </StackPanel>
                            </Button>
                            <Button Click="ExportButton_Click" IsEnabled="{Binding CanExport}" Padding="14,8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Save" />
                                    <TextBlock Text="Export" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <TextBox
                        Grid.Row="1"
                        Text="{Binding ConvertedText, Mode=TwoWay}"
                        AcceptsReturn="True"
                        TextWrapping="NoWrap"
                        FontFamily="Consolas"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Auto" />

                    <Grid Grid.Row="2">
                        <TextBlock Text="{Binding CharacterCountSummary}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{Binding LineCountSummary}" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
                </Grid>

                <ScrollViewer Visibility="{Binding JumpDriveCalculatorVisibility}" VerticalScrollBarVisibility="Auto">
                    <Grid RowSpacing="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border
                            Grid.Row="0"
                            Padding="22,20"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8">
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="14">
                                    <TextBlock Text="Starting Position" FontSize="20" FontWeight="SemiBold" />
                                    <TextBox Header="GPS paste" Text="{Binding StartGps, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="GPS:Home:0:0:0:#FF75C9F1:" />
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Header="X" Text="{Binding StartX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Grid.Column="1" Header="Y" Text="{Binding StartY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Grid.Column="2" Header="Z" Text="{Binding StartZ, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="14">
                                    <TextBlock Text="Destination" FontSize="20" FontWeight="SemiBold" />
                                    <TextBox Header="GPS paste" Text="{Binding DestinationGps, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="GPS:Base:2000000:0:0:#FF75C9F1:" />
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Header="X" Text="{Binding DestinationX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Grid.Column="1" Header="Y" Text="{Binding DestinationY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Grid.Column="2" Header="Z" Text="{Binding DestinationZ, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border
                            Grid.Row="1"
                            Padding="22,20"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8">
                            <StackPanel Spacing="16">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <ComboBox
                                        Grid.Column="0"
                                        Header="Drive type"
                                        ItemsSource="{Binding JumpDriveTypes}"
                                        SelectedItem="{Binding SelectedJumpDriveType, Mode=TwoWay}"
                                        DisplayMemberPath="Name"
                                        HorizontalAlignment="Stretch" />
                                    <ComboBox
                                        Grid.Column="1"
                                        Header="Jump drives"
                                        ItemsSource="{Binding JumpDriveCounts}"
                                        SelectedItem="{Binding SelectedJumpDriveCount, Mode=TwoWay}"
                                        HorizontalAlignment="Stretch" />
                                    <TextBox
                                        x:Name="ShipMassTextBox"
                                        Grid.Column="2"
                                        Header="Ship mass (kg)"
                                        Text="{Binding ShipMassKg, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="1,250,000.00"
                                        TextChanged="ShipMassTextBox_TextChanged"
                                        LostFocus="ShipMassTextBox_LostFocus" />
                                    <Button
                                        Grid.Column="3"
                                        Command="{Binding CalculateJumpDriveCommand}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Bottom"
                                        Padding="18,8"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        Foreground="White">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <SymbolIcon Symbol="Calculator" />
                                            <TextBlock Text="Calculate Route" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <InfoBar
                                    IsOpen="{Binding HasJumpStatusMessage}"
                                    Severity="{Binding JumpStatusSeverity}"
                                    Title="{Binding JumpStatusTitle}"
                                    Message="{Binding JumpStatusMessage}" />
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="2" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="360" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Padding="22,20"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="8">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="Route Summary" FontSize="20" FontWeight="SemiBold" />
                                    <Grid RowSpacing="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Text="Distance" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding JumpDistanceSummary}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="1" Text="Max range" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding JumpRangeSummary}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="2" Text="Jumps" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding JumpCountSummary}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="3" Text="Travel time" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding JumpTravelTimeSummary}" FontWeight="SemiBold" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border
                                Grid.Column="1"
                                Padding="22,20"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="8">
                                <Grid RowSpacing="14">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Jump Legs" FontSize="20" FontWeight="SemiBold" />
                                    <ListView Grid.Row="1" ItemsSource="{Binding JumpLegs}">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnSpacing="16" Padding="0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="220" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Number}" FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Distance}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding RechargeWait}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>

                <ScrollViewer Visibility="{Binding ResourceCalculatorVisibility}" VerticalScrollBarVisibility="Auto">
                    <Grid RowSpacing="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border
                            Grid.Row="0"
                            Padding="22,20"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8">
                            <StackPanel Spacing="16">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Resource Calculator" FontSize="24" FontWeight="SemiBold" />
                                    <TextBlock Text="Build a block list and total the required construction components." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>

                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <AutoSuggestBox
                                        Grid.Column="0"
                                        Header="Block"
                                        ItemsSource="{Binding FilteredResourceBlocks}"
                                        PlaceholderText="Search blocks, variants, or grid size"
                                        QueryIcon="Find"
                                        QuerySubmitted="ResourceBlockSearchBox_QuerySubmitted"
                                        SuggestionChosen="ResourceBlockSearchBox_SuggestionChosen"
                                        Text="{Binding BlockSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        TextMemberPath="DisplayLabel">
                                        <AutoSuggestBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid RowSpacing="2" Padding="0,4">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="{Binding DisplayLabel}" FontWeight="SemiBold" />
                                                    <TextBlock
                                                        Grid.Row="1"
                                                        Text="{Binding BlockId}"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        FontSize="12" />
                                                </Grid>
                                            </DataTemplate>
                                        </AutoSuggestBox.ItemTemplate>
                                    </AutoSuggestBox>

                                    <NumberBox
                                        Grid.Column="1"
                                        Header="Quantity"
                                        Minimum="1"
                                        SmallChange="1"
                                        SpinButtonPlacementMode="Compact"
                                        Value="{Binding SelectedResourceBlockQuantity, Mode=TwoWay}" />

                                    <Button
                                        Grid.Column="2"
                                        Command="{Binding AddResourceBlockCommand}"
                                        VerticalAlignment="Bottom"
                                        Padding="16,8"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                                        Foreground="White">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <SymbolIcon Symbol="Add" />
                                            <TextBlock Text="Add" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        Grid.Column="3"
                                        Command="{Binding ClearResourceBuildRowsCommand}"
                                        VerticalAlignment="Bottom"
                                        Padding="16,8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <SymbolIcon Symbol="Delete" />
                                            <TextBlock Text="Clear" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ComboBox
                                        Grid.Column="0"
                                        Header="Saved recipe"
                                        ItemsSource="{Binding SavedResourceRecipes}"
                                        SelectedItem="{Binding SelectedSavedResourceRecipe, Mode=TwoWay}"
                                        DisplayMemberPath="Summary"
                                        PlaceholderText="No saved recipe selected"
                                        HorizontalAlignment="Stretch" />

                                    <NumberBox
                                        Grid.Column="1"
                                        Header="Recipe qty"
                                        Minimum="1"
                                        SmallChange="1"
                                        SpinButtonPlacementMode="Compact"
                                        Value="{Binding SelectedResourceRecipeQuantity, Mode=TwoWay}" />

                                    <Button
                                        Grid.Column="2"
                                        Command="{Binding AddResourceRecipeCommand}"
                                        VerticalAlignment="Bottom"
                                        Padding="14,8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <SymbolIcon Symbol="Add" />
                                            <TextBlock Text="Add Recipe" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        Grid.Column="3"
                                        Click="SaveResourceRecipe_Click"
                                        VerticalAlignment="Bottom"
                                        Padding="14,8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <SymbolIcon Symbol="Save" />
                                            <TextBlock Text="Save" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        Grid.Column="4"
                                        Click="LoadResourceRecipe_Click"
                                        VerticalAlignment="Bottom"
                                        Padding="14,8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <SymbolIcon Symbol="OpenFile" />
                                            <TextBlock Text="Load" />
                                        </StackPanel>
                                    </Button>

                                    <Button
                                        Grid.Column="5"
                                        Click="DeleteResourceRecipe_Click"
                                        VerticalAlignment="Bottom"
                                        Padding="14,8">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <SymbolIcon Symbol="Delete" />
                                            <TextBlock Text="Delete" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <InfoBar
                                    IsOpen="{Binding HasResourceStatusMessage}"
                                    Severity="{Binding ResourceStatusSeverity}"
                                    Title="{Binding ResourceStatusTitle}"
                                    Message="{Binding ResourceStatusMessage}" />
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="1" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="360" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Padding="22,20"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="8">
                                <Grid RowSpacing="14">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Grid>
                                        <TextBlock Text="Blocks To Build" FontSize="20" FontWeight="SemiBold" />
                                        <Button
                                            Command="{Binding RecalculateResourcesCommand}"
                                            HorizontalAlignment="Right"
                                            Padding="14,8">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <SymbolIcon Symbol="Refresh" />
                                                <TextBlock Text="Recalculate" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <ListView Grid.Row="1" ItemsSource="{Binding ResourceBuildRows}">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnSpacing="12" Padding="0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="42" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding GridSize}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>

                                                    <TextBox
                                                        Grid.Column="1"
                                                        Header="Qty"
                                                        Text="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                                    <Button
                                                        Grid.Column="2"
                                                        Click="RemoveResourceBuildRow_Click"
                                                        Tag="{Binding}"
                                                        ToolTipService.ToolTip="Remove block"
                                                        VerticalAlignment="Bottom"
                                                        Padding="8">
                                                        <SymbolIcon Symbol="Cancel" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <StackPanel
                                        Grid.Row="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="8"
                                        Visibility="{Binding ResourceBuildEmptyVisibility}">
                                        <FontIcon Glyph="&#xE71D;" FontSize="34" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="No blocks added" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>

                                    <TextBlock
                                        Grid.Row="2"
                                        Text="Active Recipes"
                                        FontSize="20"
                                        FontWeight="SemiBold" />

                                    <ListView Grid.Row="3" ItemsSource="{Binding ResourceRecipeRows}">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnSpacing="12" Padding="0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="90" />
                                                        <ColumnDefinition Width="42" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Summary}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                    </StackPanel>

                                                    <TextBox
                                                        Grid.Column="1"
                                                        Header="Qty"
                                                        Text="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                                    <Button
                                                        Grid.Column="2"
                                                        Click="RemoveResourceRecipeRow_Click"
                                                        Tag="{Binding}"
                                                        ToolTipService.ToolTip="Remove recipe"
                                                        VerticalAlignment="Bottom"
                                                        Padding="8">
                                                        <SymbolIcon Symbol="Cancel" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <StackPanel
                                        Grid.Row="3"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="8"
                                        Visibility="{Binding ResourceRecipeRowsEmptyVisibility}">
                                        <FontIcon Glyph="&#xE8EC;" FontSize="34" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="No active recipes" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border
                                Grid.Column="1"
                                Padding="22,20"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="8">
                                <Grid RowSpacing="14">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Component Totals" FontSize="20" FontWeight="SemiBold" />

                                    <ListView Grid.Row="1" ItemsSource="{Binding ResourceComponentTotals}">
                                        <ListView.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnSpacing="16" Padding="0,7">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding ComponentName}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Count}" FontWeight="SemiBold" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <TextBlock
                                        Grid.Row="1"
                                        Text="Totals will appear here."
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding ResourceTotalsEmptyVisibility}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>

                <ScrollViewer Visibility="{Binding SettingsVisibility}" VerticalScrollBarVisibility="Auto">
                    <Grid RowSpacing="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border
                            Grid.Row="0"
                            Padding="22,20"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" />
                                <TextBlock Text="App preferences and update status." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>

                        <Border
                            Grid.Row="1"
                            Padding="22,20"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8">
                            <StackPanel Spacing="16">
                                <TextBlock Text="Options" FontSize="20" FontWeight="SemiBold" />

                                <ToggleSwitch Header="Remember last selected tool" IsOn="True" IsEnabled="False" />
                                <ToggleSwitch Header="Check for updates on startup" IsOn="True" IsEnabled="False" />
                                <ComboBox Header="Default app view" SelectedIndex="0" IsEnabled="False" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Image Converter" />
                                    <ComboBoxItem Content="Jump Drive Calculator" />
                                    <ComboBoxItem Content="Resource Calculator" />
                                </ComboBox>
                                <ComboBox Header="Theme" SelectedIndex="0" IsEnabled="False" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="Use system setting" />
                                    <ComboBoxItem Content="Light" />
                                    <ComboBoxItem Content="Dark" />
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="2" ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="360" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Grid.Column="0"
                                Padding="22,20"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="8">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="About" FontSize="20" FontWeight="SemiBold" />
                                    <Grid RowSpacing="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Text="Version" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CurrentVersionSummary}" FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="1" Text="App date" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AppDateSummary}" FontWeight="SemiBold" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border
                                Grid.Column="1"
                                Padding="22,20"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="8">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="Check Updates" FontSize="20" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding UpdateStatusMessage}" TextWrapping="Wrap" />
                                    <TextBlock
                                        Text="{Binding AvailableUpdateSummary}"
                                        TextWrapping="Wrap"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Visibility="{Binding UpdateAvailableVisibility}" />
                                    <ProgressBar
                                        Minimum="0"
                                        Maximum="100"
                                        Value="{Binding UpdateDownloadProgress}"
                                        Visibility="{Binding UpdateDownloadVisibility}" />
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Button Command="{Binding CheckForUpdatesCommand}" Padding="14,8">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <SymbolIcon Symbol="Refresh" />
                                                <TextBlock Text="Check for Updates" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Command="{Binding InstallUpdateCommand}"
                                            Content="{Binding InstallUpdateButtonText}"
                                            Padding="14,8"
                                            Visibility="{Binding UpdateAvailableVisibility}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
